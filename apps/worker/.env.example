NODE_ENV=development
DATABASE_URL=postgresql://morubi_app:morubi_app@localhost:5432/morubi
WORKER_COORDINATOR_DATABASE_URL=postgresql://morubi_worker:morubi_worker@localhost:5432/morubi
LOG_LEVEL=info

INTELLIGENCE_ENABLED=true
SHADOW_MODE=true
INTERVENTIONS_VISIBLE=false
REALTIME_ENABLED=false
SELLER_FEEDBACK_ENABLED=false

GENERATIVE_AI_ENABLED=false
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_TIMEOUT_MS=4000
DEEPSEEK_REASONING_TIMEOUT_MS=12000
DEEPSEEK_MAX_OUTPUT_TOKENS=512
DEEPSEEK_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
DEEPSEEK_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0

AUDIO_INTELLIGENCE_ENABLED=false
GEMINI_TRANSCRIPTION_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIPTION_TIMEOUT_MS=60000
GEMINI_TRANSCRIPTION_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
GEMINI_TRANSCRIPTION_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
GEMINI_TRANSCRIPTION_AUDIO_COST_MICROS_PER_MINUTE=0
AUDIO_STORAGE_ROOT=.data/audio
AUDIO_MAX_BYTES=20971520
AUDIO_RETENTION_DAYS=30

LIVE_CALLS_ENABLED=false
MEET_DETECTION_ENABLED=false
ZOOM_DETECTION_ENABLED=false
LIVE_TRANSCRIPTION_ENABLED=false
LIVE_COPILOT_ENABLED=false
LIVE_GENERATION_ENABLED=false
POST_CALL_INTELLIGENCE_ENABLED=false
POST_CALL_PROVIDER=fixture
POST_CALL_MAX_SEGMENT_CHARACTERS=12000
POST_CALL_MAX_OUTPUT_CHARACTERS=16000

WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=25
