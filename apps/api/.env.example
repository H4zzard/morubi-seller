NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://morubi_app:replace-with-runtime-password@localhost:5432/morubi
AUTH_DATABASE_URL=postgresql://morubi_auth:replace-with-auth-password@localhost:5432/morubi
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/morubi
TEST_DATABASE_URL=postgresql://morubi_app:replace-with-runtime-password@localhost:5432/morubi_test
TEST_AUTH_DATABASE_URL=postgresql://morubi_auth:replace-with-auth-password@localhost:5432/morubi_test
TEST_DATABASE_ADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/morubi_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DESKTOP_DEV_ORIGIN=http://localhost:5173
DESKTOP_APP_ORIGIN=morubi-app://app
LOG_LEVEL=info
LIVE_CALLS_ENABLED=false
LIVE_TRANSCRIPTION_ENABLED=false
GEMINI_TRANSCRIPTION_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_LIVE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
GEMINI_LIVE_CONNECT_TIMEOUT_MS=10000
GEMINI_LIVE_SESSION_RENEWAL_MS=540000
GEMINI_LIVE_INPUT_COST_MICROS_PER_MILLION_TOKENS=3500000
GEMINI_LIVE_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=21000000
LIVE_TRANSCRIPTION_COST_MICROS_PER_MINUTE=9000
LIVE_AUDIO_MAX_PACKET_BYTES=65536
LIVE_AUDIO_MAX_SESSION_MINUTES=90
LIVE_AUDIO_MAX_CONNECTIONS_PER_ORG=5
