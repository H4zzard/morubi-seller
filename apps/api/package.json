{
  "name": "@morubi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@morubi/ai": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@morubi/auth": "workspace:*",
    "@morubi/config": "workspace:*",
    "@morubi/contracts": "workspace:*",
    "@morubi/db": "workspace:*",
    "@morubi/domain": "workspace:*",
    "@morubi/integrations": "workspace:*",
    "@morubi/intelligence": "workspace:*",
    "@morubi/live-calls": "workspace:*",
    "@morubi/permissions": "workspace:*",
    "@morubi/validation": "workspace:*",
    "@morubi/storage": "workspace:*",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
