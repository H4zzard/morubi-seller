{
  "name": "@morubi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/src/schema.js"
    },
    "./repositories": {
      "types": "./src/repositories.ts",
      "default": "./dist/src/repositories.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:audit": "node scripts/audit-migration-order.mjs",
    "db:bootstrap-auth": "node scripts/bootstrap-auth-role.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src drizzle.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:audio": "vitest run src/audio.test.ts",
    "test:live-calls": "vitest run src/live-calls.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@morubi/ai": "workspace:*",
    "@morubi/contracts": "workspace:*",
    "@morubi/domain": "workspace:*",
    "@morubi/intelligence": "workspace:*",
    "@morubi/integrations": "workspace:*",
    "@morubi/live-calls": "workspace:*",
    "@morubi/permissions": "workspace:*",
    "@morubi/post-call": "workspace:*",
    "@morubi/storage": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
