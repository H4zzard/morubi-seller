{
  "name": "@morubi/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run src",
    "test:evaluation": "vitest run src/evaluation.test.ts",
    "test:audio": "vitest run src/transcription.test.ts src/gemini-transcription.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@morubi/intelligence": "workspace:*",
    "@morubi/post-call": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "vitest": "5.0.3"
  }
}
